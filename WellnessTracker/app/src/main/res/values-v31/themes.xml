<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme for Android 12+ to disable splash screen -->
    <style name="Base.Theme.WellnessTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Completely disable splash screen -->
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Force no splash screen at all -->
        <item name="android:windowSplashscreenContent">@null</item>
    </style>
    
    <!-- No splash theme for launch activity on Android 12+ -->
    <style name="Theme.NoSplash" parent="Base.Theme.WellnessTracker">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- Android 12+ specific splash screen disabling -->
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashscreenContent">@null</item>
    </style>
</resources>
